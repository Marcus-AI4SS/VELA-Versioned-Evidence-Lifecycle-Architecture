{
  "stages": [
    {
      "id": "stack_governance",
      "order": 10,
      "label": "栈治理",
      "description": "用于环境、技能、插件和 MCP 的治理与修复。"
    },
    {
      "id": "environment_maintenance",
      "order": 20,
      "label": "环境维护",
      "description": "用于 Python、Git、PowerShell、Codex config 和 profile 的维护。"
    },
    {
      "id": "app_blueprint",
      "order": 24,
      "label": "App 产品蓝图",
      "description": "定义 App 机会简报、用户需求、目标规格、概念选择/测试、PRD、页面地图、视觉规范、生图提示词、图标计划、原型测试、开发经济性和预览微调清单。"
    },
    {
      "id": "app_architecture",
      "order": 25,
      "label": "App 架构",
      "description": "定义桌面 app 的目标平台、仓库边界、运行模型、环境联动和交付契约。"
    },
    {
      "id": "app_implementation",
      "order": 26,
      "label": "App 实现",
      "description": "实现桌面 app UI、状态、设置、环境读取和核心交互。"
    },
    {
      "id": "app_qa",
      "order": 27,
      "label": "App QA",
      "description": "执行桌面 app 启动、自测、交互、截图、日志、回归和缺陷诊断。"
    },
    {
      "id": "app_release",
      "order": 28,
      "label": "App 发行",
      "description": "完成桌面 app 构建、打包、签名、隐私脱敏和发布准备。"
    },
    {
      "id": "research_design",
      "order": 30,
      "label": "研究设计",
      "description": "定义研究问题、边界、方法逻辑和材料策略。"
    },
    {
      "id": "literature_discovery",
      "order": 40,
      "label": "文献发现",
      "description": "建立文献池、检索边界和综述主题结构。"
    },
    {
      "id": "citation_verification",
      "order": 50,
      "label": "正式核验",
      "description": "完成正式元数据核验；证据材料里出现 DOI 时必须核验。无 DOI 条目必须记录用户提供来源、完整论文 PDF 原文或公开学术检索记录作为 DOI 豁免证据。"
    },
    {
      "id": "data_material_acquisition",
      "order": 60,
      "label": "材料获取",
      "description": "记录材料来源、平台边界和数据访问层级。"
    },
    {
      "id": "analysis_execution",
      "order": 70,
      "label": "分析执行",
      "description": "执行定量、文本、网络或仿真分析。"
    },
    {
      "id": "paper_assessment",
      "order": 80,
      "label": "论文评审",
      "description": "形成单篇论文的结构化评审与方法判断。"
    },
    {
      "id": "writing_synthesis",
      "order": 90,
      "label": "写作综合",
      "description": "形成文稿、图表、案例分析或综述输出。"
    },
    {
      "id": "review_revision",
      "order": 100,
      "label": "复核返修",
      "description": "执行 target-specific reviewer gate 与修改。"
    },
    {
      "id": "package_freeze",
      "order": 110,
      "label": "交付冻结",
      "description": "冻结最终稿、复现包和投稿材料。"
    },
    {
      "id": "runtime_supervision",
      "order": 120,
      "label": "运行监督",
      "description": "监控长时实验、checkpoint 和 worker 状态。"
    },
    {
      "id": "project_retrospective",
      "order": 130,
      "label": "项目复盘",
      "description": "复盘项目、沉淀知识并提出 skill 演化建议。"
    }
  ],
  "research_logic_chain": {
    "ask_before_advancing": true,
    "default_policy": "When Codex detects that the current research milestone is substantially complete, it must summarize the completion evidence, name the recommended next milestone, ask the user whether to advance, and wait for confirmation before switching route, starting downloads, writing files, launching multi-agent work, or changing project state.",
    "question_limit": 3,
    "milestones": [
      {
        "id": "empirical_or_field_material_ready",
        "completion_signal": "实证分析、实验结果、模型结果，或质性研究的田野资料整理已经能支撑初步论证。",
        "next_default_route": "evidence-based-literature-workflow",
        "next_default_stage": "literature_discovery",
        "next_prompt": "目前实证/田野材料已经可以支撑下一步。是否进入文献获取和候选文献库建立？"
      },
      {
        "id": "candidate_literature_pool_ready",
        "completion_signal": "候选文献表、全文获取状态、缺失 PDF 清单和基础元数据已经形成。",
        "next_default_route": "evidence-based-literature-workflow",
        "next_default_stage": "writing_synthesis",
        "next_prompt": "候选文献库已经建立。是否进入结构性阅读和文献综述？"
      },
      {
        "id": "structured_reading_and_literature_review_ready",
        "completion_signal": "结构性阅读表、主题归纳、理论基础、研究现状、方法或变量综述已经形成。",
        "next_default_route": "evidence-based-literature-workflow",
        "next_default_stage": "citation_verification",
        "next_prompt": "文献综述已经形成。是否进入引文 PDF 证据句标注和引用支撑核验？"
      },
      {
        "id": "pdf_citation_annotation_ready",
        "completion_signal": "正文将使用的引文已有 PDF 证据句、来源边界和引用支撑判断。",
        "next_default_route": "writing-export",
        "next_default_stage": "writing_synthesis",
        "next_prompt": "引文 PDF 标注已经完成。是否进入正文写作？"
      },
      {
        "id": "manuscript_draft_ready",
        "completion_signal": "正文初稿、主要论证、结果解释和引文链已经形成。",
        "next_default_route": "research-figure-design",
        "next_default_stage": "writing_synthesis",
        "next_prompt": "正文初稿已经形成。是否进入图表绘制和图文一致性检查？"
      },
      {
        "id": "figures_tables_ready",
        "completion_signal": "论文图表、图注、表注、数据口径和正文引用位置已经基本一致。",
        "next_default_route": "single-paper-review",
        "next_default_stage": "paper_assessment",
        "next_prompt": "图表已经完成。是否进入审稿式内审？"
      },
      {
        "id": "peer_review_completed_with_findings",
        "completion_signal": "审稿问题账本、硬伤判断、可修复问题和修改建议已经形成。",
        "next_default_route": "writing-export",
        "next_default_stage": "review_revision",
        "next_prompt": "审稿意见已经形成。是否进入逐条修改？"
      },
      {
        "id": "revision_cycle_completed",
        "completion_signal": "上一轮修改已完成，硬伤已处理或只剩低风险问题。",
        "next_default_route": "single-paper-review",
        "next_default_stage": "paper_assessment",
        "next_prompt": "这一轮修改已经完成。是否再审一轮，确认没有硬伤？"
      },
      {
        "id": "no_major_issue_after_review",
        "completion_signal": "再审后没有方法、证据、逻辑或引用硬伤。",
        "next_default_route": "writing-export",
        "next_default_stage": "writing_synthesis",
        "next_prompt": "当前版本没有明显硬伤。是否进入语言润色？"
      },
      {
        "id": "polished_manuscript_ready",
        "completion_signal": "语言润色完成，主张、事实、变量、结果和引用没有被改写。",
        "next_default_route": "single-paper-review",
        "next_default_stage": "paper_assessment",
        "next_prompt": "润色已经完成。是否进行一轮语言审查，检查表达、术语、段落和非 AI 化问题？"
      },
      {
        "id": "language_review_completed",
        "completion_signal": "语言审查完成，剩余修改项已经清楚。",
        "next_default_route": "writing-export",
        "next_default_stage": "review_revision",
        "next_prompt": "语言审查已经完成。是否按审查意见做最后修改？"
      },
      {
        "id": "final_text_ready_for_formatting",
        "completion_signal": "最后修改完成，正文、图表、参考文献和附录已经可进入格式整理。",
        "next_default_route": "social-science-submission-package",
        "next_default_stage": "package_freeze",
        "next_prompt": "文章内容已经基本定稿。请确认目标期刊、会议或具体格式要求，是否进入格式整理和投稿包准备？"
      }
    ]
  },
