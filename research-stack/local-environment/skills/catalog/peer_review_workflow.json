        "runtime_literature_context_pack",
        "full_text_reading_gate",
        "subtle_logic_flaw_audit",
        "domain_calibrated_review_watch_layer"
      ]
    },
    {
      "upstream": "Imbad0202/academic-research-skills",
      "repo_url": "https://github.com/Imbad0202/academic-research-skills",
      "adopted_as": [
        "reviewer_configuration_card",
