{
  "$schema": "../schemas/peer_review_workflow.v1.schema.json",
  "schema_version": "peer_review_workflow.v1",
  "updated_at": "2026-05-27",
  "policy": "本地审稿工作流采用 contract-first hybrid 方案：普通单篇论文仍走轻量结构化评审；投稿前内审、返修包、顶刊级审查、图表复现审计和用户明确要求多视角讨论时，升级为角色化审稿协议。外部仓库只作为模式来源，不整包接管本地路由、引用核验、Zotero、Obsidian 或复现链。",
  "source_review_refs": [
    {
      "upstream": "qqfly1to19/awesome_proofreading_auto",
      "repo_url": "https://github.com/qqfly1to19/awesome_proofreading_auto",
      "adopted_as": [
        "artifact_issue_ledger",
