{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/validator_result.schema.json",
  "title": "Validator Result Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "validator",
    "scope",
    "ok",
    "decision",
    "errors",
    "warnings",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "validator_result.v1"
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "needs_review",
        "fail"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object"
    }
  }
}
