{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/protected_runtime_paths.v1.schema.json",
  "title": "Protected Runtime Paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "policy",
    "paths"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "protected_runtime_paths.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/protected_path"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "protected_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "owner",
        "purpose",
        "protection_level",
        "allowed_operations",
        "forbidden_operations",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "protection_level": {
          "type": "string",
          "enum": [
            "read_metadata_only",
            "no_touch"
          ]
        },
        "allowed_operations": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_operations": {
          "$ref": "#/$defs/string_list"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
