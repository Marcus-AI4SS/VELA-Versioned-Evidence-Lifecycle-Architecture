{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/research_presentation_workflow.v1.schema.json",
  "title": "Research Presentation Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "policy",
    "source_review_refs",
    "visual_systems",
    "workflow_steps",
    "output_modes",
    "local_tool_mapping",
    "quality_rules",
    "safety_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "research_presentation_workflow.v1"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "source_review_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "visual_systems": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/visual_system"
      }
    },
    "workflow_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow_step"
      }
    },
    "output_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output_mode"
      }
    },
    "local_tool_mapping": {
      "$ref": "#/$defs/local_tool_mapping"
    },
    "quality_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quality_rule"
      }
    },
    "safety_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/safety_rule"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "repo_url",
        "commit",
        "decision",
        "adopted_as",
        "not_adopted"
      ],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/non_empty_string"
        },
        "repo_url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "$ref": "#/$defs/non_empty_string"
        },
        "decision": {
          "enum": [
            "adapt",
            "install_and_delegate",
            "watch",
            "reject"
          ]
        },
        "adopted_as": {
          "$ref": "#/$defs/string_list"
        },
        "not_adopted": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "visual_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "default_when",
        "theme_options",
        "template_path",
        "reference_files",
        "must_follow",
        "reject_when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "default_when": {
          "$ref": "#/$defs/string_list"
        },
        "theme_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/theme_option"
          }
        },
        "template_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reference_files": {
          "$ref": "#/$defs/string_list"
        },
        "must_follow": {
          "$ref": "#/$defs/string_list"
        },
        "reject_when": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "theme_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "default_when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "default_when": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "purpose",
        "required_actions",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "purpose": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_actions": {
          "$ref": "#/$defs/string_list"
        },
        "outputs": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "output_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "owner_tool",
        "default_for",
        "required_artifacts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_tool": {
          "$ref": "#/$defs/non_empty_string"
        },
        "default_for": {
          "$ref": "#/$defs/string_list"
        },
        "required_artifacts": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "local_tool_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_skill",
        "upstream_runtime_skill",
        "official_pptx_tool",
        "web_deck_template_root",
        "image_generation_policy",
        "browser_preview_policy"
      ],
      "properties": {
        "owner_skill": {
          "$ref": "#/$defs/non_empty_string"
        },
        "upstream_runtime_skill": {
          "$ref": "#/$defs/non_empty_string"
        },
        "official_pptx_tool": {
          "$ref": "#/$defs/non_empty_string"
        },
        "web_deck_template_root": {
          "$ref": "#/$defs/non_empty_string"
        },
        "image_generation_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "browser_preview_policy": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "quality_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "check"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "check": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "safety_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "failure_action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "failure_action": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
