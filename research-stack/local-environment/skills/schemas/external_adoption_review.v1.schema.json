{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/external_adoption_review.v1.schema.json",
  "title": "External Adoption Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "reviewed_at",
    "policy",
    "reviews"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "external_adoption_review.v1"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "repo_url",
        "decision",
        "current_status",
        "accepted_patterns",
        "rejected_patterns",
        "controller",
        "required_gate"
      ],
      "properties": {
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "format": "uri"
        },
        "decision": {
          "type": "string",
          "enum": [
            "keep",
            "adapt",
            "watch",
            "reject"
          ]
        },
        "current_status": {
          "type": "string",
          "minLength": 1
        },
        "accepted_patterns": {
          "$ref": "#/$defs/string_list"
        },
        "rejected_patterns": {
          "$ref": "#/$defs/string_list"
        },
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "required_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
