{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/route_explanation_report.v1.schema.json",
  "title": "Route Explanation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_files_written",
    "query",
    "selected_route",
    "route_confirmation_required",
    "clarification_required",
    "top_candidates",
    "triggered_conflict_rules",
    "clarification_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "route_explanation_report.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_files_written": {
      "const": false
    },
    "query": {
      "type": "string"
    },
    "selected_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_confirmation_required": {
      "type": "boolean"
    },
    "clarification_required": {
      "type": "boolean"
    },
    "top_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "triggered_conflict_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict_rule"
      }
    },
    "clarification_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "score",
        "matched_aliases",
        "matched_keywords",
        "profile",
        "quality_gates",
        "mcp",
        "helper_skills",
        "reason"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "matched_aliases": {
          "$ref": "#/$defs/string_list"
        },
        "matched_keywords": {
          "$ref": "#/$defs/string_list"
        },
        "profile": {
          "type": "string"
        },
        "quality_gates": {
          "$ref": "#/$defs/string_list"
        },
        "mcp": {
          "$ref": "#/$defs/string_list"
        },
        "helper_skills": {
          "$ref": "#/$defs/string_list"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "conflict_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "winner",
        "reason"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "winner": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
