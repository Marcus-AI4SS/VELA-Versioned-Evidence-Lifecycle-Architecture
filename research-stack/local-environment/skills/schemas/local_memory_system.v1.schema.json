{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/local_memory_system.v1.schema.json",
  "title": "Local Memory System Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "selected_plan",
    "design_principles",
    "external_inputs",
    "memory_layers",
    "candidate_pipeline",
    "retrieval_policy",
    "runtime_adapter_policy",
    "scoring_policy",
    "automation_policy",
    "health_policy",
    "storage_boundaries",
    "schema_refs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "local_memory_system.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "selected_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "selected"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "design_principles": {
      "$ref": "#/$defs/string_list"
    },
    "external_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/external_input"
      }
    },
    "memory_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/memory_layer"
      }
    },
    "candidate_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "default_candidate_status",
        "promotion_rules",
        "hard_block_rules"
      ],
      "properties": {
        "steps": {
          "$ref": "#/$defs/string_list"
        },
        "default_candidate_status": {
          "type": "string",
          "enum": [
            "candidate",
            "needs_review"
          ]
        },
        "promotion_rules": {
          "$ref": "#/$defs/string_list"
        },
        "hard_block_rules": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "scoring_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manual_review_threshold",
        "promotion_threshold",
        "weights",
        "risk_penalties"
      ],
      "properties": {
        "manual_review_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "promotion_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weights": {
          "$ref": "#/$defs/score_component_map"
        },
        "risk_penalties": {
          "$ref": "#/$defs/score_component_map"
        }
      }
    },
    "automation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "default_execution_environment",
        "allowed_auto_actions",
        "forbidden_auto_actions",
        "allowed_source_write_scope",
        "required_gates",
        "run_ledger_output_dir",
        "weekly_review_scope",
        "protected_runtime_paths_ref"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "proposal_only",
            "controlled_auto_landing"
          ]
        },
        "default_execution_environment": {
          "type": "string",
          "enum": [
            "local",
            "worktree"
          ]
        },
        "allowed_auto_actions": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_auto_actions": {
          "$ref": "#/$defs/string_list"
        },
        "allowed_source_write_scope": {
          "$ref": "#/$defs/string_list"
        },
        "required_gates": {
          "$ref": "#/$defs/string_list"
        },
        "run_ledger_output_dir": {
          "type": "string",
          "minLength": 1
        },
        "weekly_review_scope": {
          "$ref": "#/$defs/string_list"
        },
        "protected_runtime_paths_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "health_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_checks",
        "status_report_schema",
        "probe_style"
      ],
      "properties": {
        "startup_checks": {
          "$ref": "#/$defs/string_list"
        },
        "status_report_schema": {
          "type": "string",
          "minLength": 1
        },
        "probe_style": {
          "type": "string",
          "enum": [
            "observe_verify_report",
            "observe_verify_repair"
          ]
        }
      }
    },
    "storage_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "runtime_derivative",
        "forbidden_defaults"
      ],
      "properties": {
        "source_of_truth": {
          "$ref": "#/$defs/string_list"
        },
        "runtime_derivative": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_defaults": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "schema_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "status_report",
        "reconciliation_report"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "status_report": {
          "type": "string",
          "minLength": 1
        },
        "reconciliation_report": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled_interfaces",
        "default_retrieval_order",
        "cross_session_injection_policy",
        "confidence_policy",
        "task_state_policy",
        "cleanup_policy",
        "interface_controls",
        "optional_semantic_search"
      ],
      "properties": {
        "enabled_interfaces": {
          "$ref": "#/$defs/string_list"
        },
        "default_retrieval_order": {
          "$ref": "#/$defs/string_list"
        },
        "cross_session_injection_policy": {
          "$ref": "#/$defs/string_list"
        },
        "confidence_policy": {
          "$ref": "#/$defs/string_list"
        },
        "task_state_policy": {
          "$ref": "#/$defs/string_list"
        },
        "cleanup_policy": {
          "$ref": "#/$defs/string_list"
        },
        "interface_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interface_control"
          }
        },
        "optional_semantic_search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "allowed_engine_patterns",
            "hard_limits"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "watch_only",
                "dry_run_only",
                "enabled_read_only"
              ]
            },
            "allowed_engine_patterns": {
              "$ref": "#/$defs/string_list"
            },
            "hard_limits": {
              "$ref": "#/$defs/string_list"
            }
          }
        }
      }
    },
    "runtime_adapter_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_adapter",
        "status",
        "version",
        "engine",
        "data_root",
        "ports",
        "codex_integration",
        "allowed_actions",
        "forbidden_actions",
        "promotion_boundary",
        "health_check"
      ],
      "properties": {
        "selected_adapter": {
          "type": "string",
          "enum": [
            "local_contract_only",
            "agentmemory"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "disabled",
            "enabled",
            "trial"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "$ref": "#/$defs/string_list"
        },
        "codex_integration": {
          "$ref": "#/$defs/string_list"
        },
        "allowed_actions": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_actions": {
          "$ref": "#/$defs/string_list"
        },
        "promotion_boundary": {
          "type": "string",
          "minLength": 1
        },
        "health_check": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "decision",
        "absorbed_patterns",
        "rejected_patterns"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "adapt",
            "watch",
            "reject"
          ]
        },
        "absorbed_patterns": {
          "$ref": "#/$defs/string_list"
        },
        "rejected_patterns": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "memory_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "default_target",
        "ttl_days",
        "auto_promotion_allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "ephemeral_session",
            "project_memory",
            "private_preference",
            "procedural_memory",
            "control_memory",
            "discarded_noise"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "default_target": {
          "type": "string",
          "enum": [
            "control_kernel",
            "skill",
            "obsidian",
            "codex_native",
            "evolution_backlog",
            "discard"
          ]
        },
        "ttl_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "auto_promotion_allowed": {
          "type": "boolean"
        }
      }
    },
    "score_component_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "recurrence",
        "actionability",
        "stability",
        "scope_fit",
        "validator_support",
        "privacy_risk",
        "conflict_risk",
        "staleness"
      ],
      "properties": {
        "evidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recurrence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "actionability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scope_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validator_support": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "privacy_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conflict_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "staleness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "interface_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "purpose",
        "required_fields",
        "safety_rules",
        "failure_behavior"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "$ref": "#/$defs/string_list"
        },
        "safety_rules": {
          "$ref": "#/$defs/string_list"
        },
        "failure_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
