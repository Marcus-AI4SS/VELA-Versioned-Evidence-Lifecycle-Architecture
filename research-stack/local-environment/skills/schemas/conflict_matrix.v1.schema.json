{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/conflict_matrix.v1.schema.json",
  "title": "Route Conflict Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "rules",
    "retired_skills"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "conflict_matrix.v1"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "retired_skills": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "winner",
        "losers",
        "reason"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "winner": {
          "type": "string",
          "minLength": 1
        },
        "losers": {
          "$ref": "#/$defs/string_list"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
