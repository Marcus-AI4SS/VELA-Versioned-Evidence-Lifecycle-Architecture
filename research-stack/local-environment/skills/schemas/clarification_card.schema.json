{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/clarification_card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id",
    "target_item_count",
    "work_units",
    "deliverable_types",
    "sync_targets",
    "explicit_project_mode",
    "needs_clarification",
    "route_confirmation_required",
    "route_confirmation_question",
    "user_confirmed_route"
  ],
  "properties": {
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "target_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "work_units": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deliverable_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sync_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "explicit_project_mode": {
      "type": "string",
      "enum": [
        "auto",
        "force_multi_agent",
        "force_single_agent"
      ]
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "route_confirmation_required": {
      "type": "boolean"
    },
    "route_confirmation_question": {
      "type": "string"
    },
    "user_confirmed_route": {
      "type": "boolean"
    }
  }
}
