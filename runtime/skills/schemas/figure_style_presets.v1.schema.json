{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/figure_style_presets.v1.schema.json",
  "title": "Figure Style Presets Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "policy",
    "default_presets",
    "presets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "figure_style_presets.v1"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "default_presets": {
      "$ref": "#/$defs/default_presets"
    },
    "presets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "color_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hex",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "default_presets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_research_figure",
        "empirical_figure",
        "review_ready_figure",
        "presentation_figure"
      ],
      "properties": {
        "formal_research_figure": {
          "type": "string",
          "minLength": 1
        },
        "empirical_figure": {
          "type": "string",
          "minLength": 1
        },
        "review_ready_figure": {
          "type": "string",
          "minLength": 1
        },
        "presentation_figure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "default_for",
        "style_role",
        "source_inspiration",
        "use_cases",
        "figure_types",
        "palette",
        "typography",
        "line_style",
        "arrow_style",
        "panel_layout",
        "legend_rules",
        "whitespace_rules",
        "title_caption_policy",
        "output_formats",
        "image2_prompt_requirements",
        "overlap_checks",
        "forbidden_elements",
        "quality_checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "default_for": {
          "$ref": "#/$defs/string_list"
        },
        "style_role": {
          "type": "string",
          "minLength": 1
        },
        "source_inspiration": {
          "$ref": "#/$defs/string_list"
        },
        "use_cases": {
          "$ref": "#/$defs/string_list"
        },
        "figure_types": {
          "$ref": "#/$defs/string_list"
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "neutral",
            "primary",
            "secondary",
            "accent",
            "constraints"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/string_list"
            },
            "neutral": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/color_token"
              }
            },
            "primary": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/color_token"
              }
            },
            "secondary": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/color_token"
              }
            },
            "accent": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/color_token"
              }
            },
            "constraints": {
              "$ref": "#/$defs/string_list"
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_policy",
            "base_pt",
            "label_pt",
            "caption_outside_pt",
            "rules"
          ],
          "properties": {
            "font_policy": {
              "type": "string",
              "minLength": 1
            },
            "base_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "label_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "caption_outside_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rules": {
              "$ref": "#/$defs/string_list"
            }
          }
        },
        "line_style": {
          "$ref": "#/$defs/string_list"
        },
        "arrow_style": {
          "$ref": "#/$defs/string_list"
        },
        "panel_layout": {
          "$ref": "#/$defs/string_list"
        },
        "legend_rules": {
          "$ref": "#/$defs/string_list"
        },
        "whitespace_rules": {
          "$ref": "#/$defs/string_list"
        },
        "title_caption_policy": {
          "$ref": "#/$defs/string_list"
        },
        "output_formats": {
          "$ref": "#/$defs/string_list"
        },
        "image2_prompt_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_tokens",
            "required_phrases"
          ],
          "properties": {
            "prompt_tokens": {
              "$ref": "#/$defs/string_list"
            },
            "required_phrases": {
              "$ref": "#/$defs/string_list"
            }
          }
        },
        "overlap_checks": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_elements": {
          "$ref": "#/$defs/string_list"
        },
        "quality_checks": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
