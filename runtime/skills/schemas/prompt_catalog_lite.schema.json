{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/prompt_catalog_lite.schema.json",

  "title": "Prompt Catalog Lite",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "generated_at",

    "prompts"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "prompt_catalog_lite.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "prompts": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/prompt"

      }

    }

  },

  "$defs": {

    "string_list": {

      "type": "array",

      "items": {

        "type": "string",

        "minLength": 1

      },

      "uniqueItems": true

    },

    "prompt": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "version",

        "owner",

        "scope",

        "purpose",

        "source_file",

        "failure_modes",

        "evaluation_notes"

      ],

      "properties": {

        "id": {

          "type": "string",

          "pattern": "^[A-Za-z0-9_.-]+$"

        },

        "version": {

          "type": "string",

          "minLength": 1

        },

        "owner": {

          "type": "string",

          "minLength": 1

        },

        "scope": {

          "type": "string",

          "minLength": 1

        },

        "purpose": {

          "type": "string",

          "minLength": 1

        },

        "source_file": {

          "type": "string",

          "minLength": 1

        },

        "failure_modes": {

          "$ref": "#/$defs/string_list"

        },

        "evaluation_notes": {

          "$ref": "#/$defs/string_list"

        }

      }

    }

  }

}
