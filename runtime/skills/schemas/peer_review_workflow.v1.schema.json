{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/peer_review_workflow.v1.schema.json",

  "title": "Peer Review Workflow Contract",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "updated_at",

    "policy",

    "source_review_refs",

    "adoption_options",

    "selected_strategy",

    "modes",

    "trigger_rules",

    "roles",

    "stage_sequence",

    "issue_contract",

    "report_contracts",

    "safety_rules"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "peer_review_workflow.v1"

    },

    "updated_at": {

      "type": "string",

      "minLength": 1

    },

    "policy": {

      "type": "string",

      "minLength": 1

    },

    "source_review_refs": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/source_ref"

      }

    },

    "adoption_options": {

      "type": "array",

      "minItems": 2,

      "items": {

        "$ref": "#/$defs/adoption_option"

      }

    },

    "selected_strategy": {

      "type": "string",

      "minLength": 1

    },

    "modes": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/mode"

      }

    },

    "trigger_rules": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/trigger_rule"

      }

    },

    "roles": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/review_role"

      }

    },

    "stage_sequence": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/stage"

      }

    },

    "issue_contract": {

      "$ref": "#/$defs/issue_contract"

    },

    "report_contracts": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/report_contract"

      }

    },

    "safety_rules": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/safety_rule"

      }

    }

  },

  "$defs": {

    "non_empty_string": {

      "type": "string",

      "minLength": 1

    },

    "string_list": {

      "type": "array",

      "items": {

        "$ref": "#/$defs/non_empty_string"

      },

      "uniqueItems": true

    },

    "source_ref": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "upstream",

        "repo_url",

        "adopted_as"

      ],

      "properties": {

        "upstream": {

          "$ref": "#/$defs/non_empty_string"

        },

        "repo_url": {

          "type": "string",

          "format": "uri"

        },

        "adopted_as": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "adoption_option": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "decision",

        "description",

        "upstream_strengths",

        "local_risks"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "decision": {

          "type": "string",

          "enum": [

            "selected",

            "partial",

            "watch",

            "reject_as_default"

          ]

        },

        "description": {

          "$ref": "#/$defs/non_empty_string"

        },

        "upstream_strengths": {

          "$ref": "#/$defs/string_list"

        },

        "local_risks": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "mode": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "description",

        "default_subagent_policy",

        "trigger_signals",

        "required_inputs",

        "stage_ids",

        "outputs"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "description": {

          "$ref": "#/$defs/non_empty_string"

        },

        "default_subagent_policy": {

          "type": "string",

          "enum": [

            "none",

            "role_simulation_only",

            "conditional_subagents",

            "always_multi_agent"

          ]

        },

        "trigger_signals": {

          "$ref": "#/$defs/string_list"

        },

        "required_inputs": {

          "$ref": "#/$defs/string_list"

        },

        "stage_ids": {

          "$ref": "#/$defs/string_list"

        },

        "outputs": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "trigger_rule": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "route_id",

        "mode_id",

        "signals",

        "excluded_when"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "route_id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "mode_id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "signals": {

          "$ref": "#/$defs/string_list"

        },

        "excluded_when": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "review_role": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "role_id",

        "display_name",

        "purpose",

        "allowed_actions",

        "forbidden_actions",

        "output_fields"

      ],

      "properties": {

        "role_id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "display_name": {

          "$ref": "#/$defs/non_empty_string"

        },

        "purpose": {

          "$ref": "#/$defs/non_empty_string"

        },

        "allowed_actions": {

          "$ref": "#/$defs/string_list"

        },

        "forbidden_actions": {

          "$ref": "#/$defs/string_list"

        },

        "output_fields": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "stage": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "description",

        "applies_to_modes",

        "inputs",

        "outputs",

        "blockers"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "description": {

          "$ref": "#/$defs/non_empty_string"

        },

        "applies_to_modes": {

          "$ref": "#/$defs/string_list"

        },

        "inputs": {

          "$ref": "#/$defs/string_list"

        },

        "outputs": {

          "$ref": "#/$defs/string_list"

        },

        "blockers": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "issue_contract": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "severity_values",

        "status_values",

        "required_fields",

        "optional_fields"

      ],

      "properties": {

        "severity_values": {

          "$ref": "#/$defs/string_list"

        },

        "status_values": {

          "$ref": "#/$defs/string_list"

        },

        "required_fields": {

          "$ref": "#/$defs/string_list"

        },

        "optional_fields": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "report_contract": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "path_template",

        "producer",

        "consumed_by_gates",

        "required_sections"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "path_template": {

          "$ref": "#/$defs/non_empty_string"

        },

        "producer": {

          "$ref": "#/$defs/non_empty_string"

        },

        "consumed_by_gates": {

          "$ref": "#/$defs/string_list"

        },

        "required_sections": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "safety_rule": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "rule",

        "failure_action"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "rule": {

          "$ref": "#/$defs/non_empty_string"

        },

        "failure_action": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    }

  }

}
