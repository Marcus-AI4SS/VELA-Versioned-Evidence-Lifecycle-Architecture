{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/research_team_playbook.schema.json",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "generated_at",

    "playbooks"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "research_team_playbook.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "playbooks": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/playbook"

      }

    }

  },

  "$defs": {

    "string_id": {

      "type": "string",

      "pattern": "^[A-Za-z0-9_-]+$"

    },

    "string_list": {

      "type": "array",

      "items": {

        "type": "string",

        "minLength": 1

      },

      "uniqueItems": true

    },

    "condition_group": {

      "type": "object",

      "additionalProperties": false,

      "minProperties": 1,

      "properties": {

        "route_id_is": {

          "$ref": "#/$defs/string_list"

        },

        "work_units_contains_any": {

          "$ref": "#/$defs/string_list"

        },

        "deliverable_types_contains_any": {

          "$ref": "#/$defs/string_list"

        },

        "sync_targets_contains_any": {

          "$ref": "#/$defs/string_list"

        },

        "explicit_project_mode_is": {

          "$ref": "#/$defs/string_list"

        },

        "target_item_count_gte": {

          "type": "integer",

          "minimum": 0

        },

        "target_item_count_gt": {

          "type": "integer",

          "minimum": 0

        },

        "needs_clarification_is": {

          "type": "boolean"

        }

      }

    },

    "include_when": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "any_of"

      ],

      "properties": {

        "any_of": {

          "type": "array",

          "minItems": 1,

          "items": {

            "$ref": "#/$defs/condition_group"

          }

        }

      }

    },

    "optional_agent": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "agent_id",

        "include_when"

      ],

      "properties": {

        "agent_id": {

          "$ref": "#/$defs/string_id"

        },

        "include_when": {

          "$ref": "#/$defs/include_when"

        },

        "reason": {

          "type": "string",

          "minLength": 1

        }

      }

    },

    "review_pair": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "producer",

        "reviewer"

      ],

      "properties": {

        "producer": {

          "$ref": "#/$defs/string_id"

        },

        "reviewer": {

          "$ref": "#/$defs/string_id"

        }

      }

    },

    "playbook": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "route_id",

        "squad_name",

        "mission",

        "default_agents",

        "optional_agents",

        "primary_outputs",

        "review_chain"

      ],

      "properties": {

        "route_id": {

          "$ref": "#/$defs/string_id"

        },

        "squad_name": {

          "type": "string",

          "minLength": 1

        },

        "mission": {

          "type": "string",

          "minLength": 1

        },

        "default_agents": {

          "$ref": "#/$defs/string_list"

        },

        "optional_agents": {

          "type": "array",

          "items": {

            "$ref": "#/$defs/optional_agent"

          }

        },

        "primary_outputs": {

          "$ref": "#/$defs/string_list"

        },

        "review_chain": {

          "type": "array",

          "items": {

            "$ref": "#/$defs/review_pair"

          }

        }

      }

    }

  }

}
