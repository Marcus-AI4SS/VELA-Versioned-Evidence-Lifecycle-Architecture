{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-environment-local/schemas/thread_memory_intake_report.v1.schema.json",
  "title": "Thread Memory Intake Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "mode",
    "source_files_written",
    "source_ref",
    "thread_id",
    "route_id",
    "raw_transcript_ingested",
    "observation_count",
    "observations",
    "skill_evolution_candidates",
    "backlog_events",
    "rejected_count",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "thread_memory_intake_report.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "controlled_auto_landing"
    },
    "source_files_written": {
      "type": "boolean"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "raw_transcript_ingested": {
      "const": false
    },
    "observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "skill_evolution_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_evolution_candidate"
      }
    },
    "backlog_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/backlog_event"
      }
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "next_actions": {
      "$ref": "#/$defs/string_list"
    },
    "report_written": {
      "type": [
        "string",
        "null"
      ]
    },
    "backlog_append": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "score_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "admission_score",
        "decision",
        "reason",
        "schema_errors",
        "hard_blocks",
        "proposed_target"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "admission_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "rejected",
            "discard_or_ephemeral",
            "needs_review",
            "promotion_plan"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "schema_errors": {
          "$ref": "#/$defs/string_list_relaxed"
        },
        "hard_blocks": {
          "$ref": "#/$defs/string_list_relaxed"
        },
        "proposed_target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "string_list_relaxed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "signal_type",
        "target_skill",
        "memory_candidate_id",
        "memory_layer",
        "privacy_scope",
        "proposed_target",
        "decision",
        "skill_evolution_eligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "signal_type": {
          "type": "string",
          "minLength": 1
        },
        "target_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "memory_layer": {
          "type": "string",
          "minLength": 1
        },
        "privacy_scope": {
          "type": "string",
          "minLength": 1
        },
        "proposed_target": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/score_result"
        },
        "skill_evolution_eligible": {
          "type": "boolean"
        }
      }
    },
    "skill_evolution_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_candidate_id",
        "target_skill",
        "claim",
        "decision",
        "required_gates"
      ],
      "properties": {
        "memory_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "target_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "required_gates": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "backlog_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "proposed_target",
        "severity",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_target": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
