{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/empirical_quant_workflow.v1.schema.json",

  "title": "Empirical Quant Workflow",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "updated_at",

    "policy",

    "source_review_refs",

    "adoption_options",

    "selected_strategy",

    "workflow_modes",

    "design_families",

    "tool_ecosystems",

    "diagnostics",

    "robustness_ladder",

    "output_contract",

    "safety_rules"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "empirical_quant_workflow.v1"

    },

    "updated_at": {

      "type": "string",

      "minLength": 1

    },

    "policy": {

      "type": "string",

      "minLength": 1

    },

    "source_review_refs": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/source_ref"

      }

    },

    "adoption_options": {

      "type": "array",

      "minItems": 3,

      "items": {

        "$ref": "#/$defs/adoption_option"

      }

    },

    "selected_strategy": {

      "$ref": "#/$defs/non_empty_string"

    },

    "workflow_modes": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/workflow_mode"

      }

    },

    "design_families": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/design_family"

      }

    },

    "tool_ecosystems": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/tool_ecosystem"

      }

    },

    "diagnostics": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/diagnostic"

      }

    },

    "robustness_ladder": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/robustness_step"

      }

    },

    "output_contract": {

      "$ref": "#/$defs/output_contract"

    },

    "safety_rules": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/safety_rule"

      }

    }

  },

  "$defs": {

    "non_empty_string": {

      "type": "string",

      "minLength": 1

    },

    "id": {

      "type": "string",

      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"

    },

    "string_list": {

      "type": "array",

      "items": {

        "$ref": "#/$defs/non_empty_string"

      },

      "uniqueItems": true

    },

    "source_ref": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "upstream",

        "repo_url",

        "commit",

        "adopted_as",

        "not_adopted"

      ],

      "properties": {

        "upstream": {

          "$ref": "#/$defs/non_empty_string"

        },

        "repo_url": {

          "type": "string",

          "format": "uri"

        },

        "commit": {

          "$ref": "#/$defs/non_empty_string"

        },

        "adopted_as": {

          "$ref": "#/$defs/string_list"

        },

        "not_adopted": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "adoption_option": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "decision",

        "description",

        "strengths",

        "risks"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "decision": {

          "enum": [

            "selected",

            "adapt",

            "watch",

            "reject_as_default"

          ]

        },

        "description": {

          "$ref": "#/$defs/non_empty_string"

        },

        "strengths": {

          "$ref": "#/$defs/string_list"

        },

        "risks": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "workflow_mode": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "trigger_signals",

        "required_inputs",

        "required_steps",

        "outputs"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "trigger_signals": {

          "$ref": "#/$defs/string_list"

        },

        "required_inputs": {

          "$ref": "#/$defs/string_list"

        },

        "required_steps": {

          "$ref": "#/$defs/string_list"

        },

        "outputs": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "design_family": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "use_when",

        "required_inputs",

        "preferred_estimators",

        "required_diagnostics",

        "red_flags"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "use_when": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_inputs": {

          "$ref": "#/$defs/string_list"

        },

        "preferred_estimators": {

          "$ref": "#/$defs/string_list"

        },

        "required_diagnostics": {

          "$ref": "#/$defs/string_list"

        },

        "red_flags": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "diagnostic": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "purpose",

        "checks",

        "failure_action"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "purpose": {

          "$ref": "#/$defs/non_empty_string"

        },

        "checks": {

          "$ref": "#/$defs/string_list"

        },

        "failure_action": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    },

    "tool_ecosystem": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "use_when",

        "required_conventions",

        "core_packages_or_commands",

        "pipeline_files",

        "outputs",

        "red_flags"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "use_when": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_conventions": {

          "$ref": "#/$defs/string_list"

        },

        "core_packages_or_commands": {

          "$ref": "#/$defs/string_list"

        },

        "pipeline_files": {

          "$ref": "#/$defs/string_list"

        },

        "outputs": {

          "$ref": "#/$defs/string_list"

        },

        "red_flags": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "robustness_step": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "purpose",

        "required_for",

        "outputs"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "purpose": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_for": {

          "$ref": "#/$defs/string_list"

        },

        "outputs": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "output_contract": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "quality_gate_report",

        "required_artifacts",

        "optional_artifacts",

        "accepted_statuses"

      ],

      "properties": {

        "quality_gate_report": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_artifacts": {

          "$ref": "#/$defs/string_list"

        },

        "optional_artifacts": {

          "$ref": "#/$defs/string_list"

        },

        "accepted_statuses": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "safety_rule": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "rule",

        "failure_action"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/id"

        },

        "rule": {

          "$ref": "#/$defs/non_empty_string"

        },

        "failure_action": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    }

  }

}
