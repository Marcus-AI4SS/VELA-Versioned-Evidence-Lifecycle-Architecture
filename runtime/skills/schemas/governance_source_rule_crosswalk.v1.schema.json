{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/governance_source_rule_crosswalk.v1.schema.json",

  "title": "Governance Source Rule Crosswalk",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "generated_at",

    "scope",

    "sources",

    "principles"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "governance_source_rule_crosswalk.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "scope": {

      "type": "string",

      "enum": [

        "source_to_local_rule_traceability"

      ]

    },

    "sources": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/source"

      }

    },

    "principles": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/principle"

      }

    }

  },

  "$defs": {

    "string_id": {

      "type": "string",

      "pattern": "^[A-Za-z0-9_.-]+$"

    },

    "string_list": {

      "type": "array",

      "minItems": 1,

      "items": {

        "type": "string",

        "minLength": 1

      },

      "uniqueItems": true

    },

    "source": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "title",

        "source_type",

        "evidence_status",

        "formal_citation_status"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/string_id"

        },

        "title": {

          "type": "string",

          "minLength": 1

        },

        "source_type": {

          "type": "string",

          "enum": [

            "local_book",

            "public_platform_article",

            "official_post",

            "peer_reviewed_article",

            "institutional_article"

          ]

        },

        "url": {

          "type": "string",

          "minLength": 1

        },

        "doi": {

          "type": "string",

          "minLength": 1

        },

        "evidence_status": {

          "type": "string",

          "minLength": 1

        },

        "formal_citation_status": {

          "type": "string",

          "enum": [

            "local_source_only",

            "doi_verified",

            "not_for_formal_academic_citation",

            "external_interpretation_only"

          ]

        }

      }

    },

    "artifact": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "ref",

        "role"

      ],

      "properties": {

        "ref": {

          "type": "string",

          "minLength": 1

        },

        "role": {

          "type": "string",

          "minLength": 1

        }

      }

    },

    "principle": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "name",

        "source_ids",

        "extracted_methodology",

        "local_rule",

        "local_artifacts",

        "verification_gates",

        "implementation_status",

        "gap_closed"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/string_id"

        },

        "name": {

          "type": "string",

          "minLength": 1

        },

        "source_ids": {

          "$ref": "#/$defs/string_list"

        },

        "extracted_methodology": {

          "type": "string",

          "minLength": 1

        },

        "local_rule": {

          "type": "string",

          "minLength": 1

        },

        "local_artifacts": {

          "type": "array",

          "minItems": 1,

          "items": {

            "$ref": "#/$defs/artifact"

          }

        },

        "verification_gates": {

          "$ref": "#/$defs/string_list"

        },

        "implementation_status": {

          "type": "string",

          "enum": [

            "implemented",

            "watch"

          ]

        },

        "gap_closed": {

          "type": "string",

          "minLength": 1

        }

      }

    }

  }

}
