{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/environment_layer_contract.v1.schema.json",

  "title": "Environment Layer Contract",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "generated_at",

    "policy",

    "core_methodology_ref",

    "layer_order",

    "layers",

    "route_layer_map",

    "skill_layer_map",

    "tool_inventory",

    "memory_optimization",

    "conflict_audit",

    "governance_assertions"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "environment_layer_contract.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "policy": {

      "type": "string",

      "minLength": 1

    },

    "core_methodology_ref": {

      "type": "string",

      "minLength": 1

    },

    "layer_order": {

      "type": "array",

      "minItems": 7,

      "maxItems": 7,

      "items": {

        "$ref": "#/$defs/layer_id"

      },

      "uniqueItems": true

    },

    "layers": {

      "type": "array",

      "minItems": 7,

      "maxItems": 7,

      "items": {

        "$ref": "#/$defs/layer"

      }

    },

    "route_layer_map": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/route_layer"

      }

    },

    "skill_layer_map": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/skill_layer"

      }

    },

    "tool_inventory": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/tool"

      }

    },

    "memory_optimization": {

      "$ref": "#/$defs/memory_optimization"

    },

    "conflict_audit": {

      "$ref": "#/$defs/conflict_audit"

    },

    "governance_assertions": {

      "$ref": "#/$defs/string_list"

    }

  },

  "$defs": {

    "layer_id": {

      "type": "string",

      "enum": [

        "execution",

        "tool",

        "context",

        "lifecycle",

        "observability",

        "verification",

        "governance"

      ]

    },

    "non_empty_string": {

      "type": "string",

      "minLength": 1

    },

    "string_list": {

      "type": "array",

      "items": {

        "$ref": "#/$defs/non_empty_string"

      },

      "uniqueItems": true

    },

    "layer_list": {

      "type": "array",

      "items": {

        "$ref": "#/$defs/layer_id"

      },

      "uniqueItems": true

    },

    "layer": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "plain_meaning",

        "responsibility",

        "source_contracts",

        "primary_components",

        "observability",

        "verification"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/layer_id"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "plain_meaning": {

          "$ref": "#/$defs/non_empty_string"

        },

        "responsibility": {

          "$ref": "#/$defs/non_empty_string"

        },

        "source_contracts": {

          "$ref": "#/$defs/string_list"

        },

        "primary_components": {

          "$ref": "#/$defs/string_list"

        },

        "observability": {

          "$ref": "#/$defs/string_list"

        },

        "verification": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "route_layer": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "route_id",

        "main_layer",

        "required_layers",

        "lifecycle_stages",

        "verification_gates"

      ],

      "properties": {

        "route_id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "main_layer": {

          "$ref": "#/$defs/layer_id"

        },

        "required_layers": {

          "$ref": "#/$defs/layer_list"

        },

        "lifecycle_stages": {

          "$ref": "#/$defs/string_list"

        },

        "verification_gates": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "skill_layer": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "skill_id",

        "primary_layer",

        "secondary_layers",

        "role",

        "task_type"

      ],

      "properties": {

        "skill_id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "primary_layer": {

          "$ref": "#/$defs/layer_id"

        },

        "secondary_layers": {

          "$ref": "#/$defs/layer_list"

        },

        "role": {

          "$ref": "#/$defs/non_empty_string"

        },

        "task_type": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    },

    "tool": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "kind",

        "layer",

        "source",

        "use_boundary",

        "write_boundary"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "kind": {

          "enum": [

            "mcp",

            "plugin",

            "cli",

            "runtime",

            "automation",

            "knowledge_store"

          ]

        },

        "layer": {

          "$ref": "#/$defs/layer_id"

        },

        "source": {

          "$ref": "#/$defs/non_empty_string"

        },

        "use_boundary": {

          "$ref": "#/$defs/non_empty_string"

        },

        "write_boundary": {

          "$ref": "#/$defs/non_empty_string"

        },

        "safety_controls": {

          "type": "object",

          "additionalProperties": false,

          "required": [

            "source_of_truth_policy",

            "allowed_write_scope",

            "forbidden_actions",

            "delete_policy",

            "audit_policy"

          ],

          "properties": {

            "source_of_truth_policy": {

              "$ref": "#/$defs/non_empty_string"

            },

            "allowed_write_scope": {

              "$ref": "#/$defs/string_list"

            },

            "forbidden_actions": {

              "$ref": "#/$defs/string_list"

            },

            "delete_policy": {

              "$ref": "#/$defs/non_empty_string"

            },

            "audit_policy": {

              "$ref": "#/$defs/non_empty_string"

            }

          }

        }

      }

    },

    "memory_optimization": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "decision",

        "adopted_from_screenshot",

        "not_adopted",

        "local_contract_ref",

        "required_interfaces"

      ],

      "properties": {

        "decision": {

          "enum": [

            "adapt_lightweight",

            "adopt_runtime_adapter",

            "watch",

            "reject"

          ]

        },

        "adopted_from_screenshot": {

          "$ref": "#/$defs/string_list"

        },

        "not_adopted": {

          "$ref": "#/$defs/string_list"

        },

        "local_contract_ref": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_interfaces": {

          "$ref": "#/$defs/string_list"

        },

        "adopted_from_agentmemory": {

          "$ref": "#/$defs/string_list"

        },

        "runtime_boundaries": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "conflict_audit": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "route_conflict_source",

        "tool_conflict_source",

        "skill_conflict_source",

        "required_checks"

      ],

      "properties": {

        "route_conflict_source": {

          "$ref": "#/$defs/non_empty_string"

        },

        "tool_conflict_source": {

          "$ref": "#/$defs/non_empty_string"

        },

        "skill_conflict_source": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_checks": {

          "$ref": "#/$defs/string_list"

        }

      }

    }

  }

}
