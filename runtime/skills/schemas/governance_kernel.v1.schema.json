{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/governance_kernel.v1.schema.json",

  "title": "Workflow Governance Kernel",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "generated_at",

    "system_boundary",

    "source_material",

    "control_objectives",

    "controlled_variables",

    "feedback_signals",

    "controllers",

    "actuators",

    "disturbance_classes",

    "stability_metrics",

    "adaptation_rules",

    "memory_policy_ref",

    "external_adoption_policy_ref"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "governance_kernel.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "system_boundary": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "system_name",

        "source_of_truth_repo",

        "managed_repositories",

        "out_of_scope"

      ],

      "properties": {

        "system_name": {

          "type": "string",

          "minLength": 1

        },

        "source_of_truth_repo": {

          "type": "string",

          "minLength": 1

        },

        "managed_repositories": {

          "$ref": "#/$defs/string_list"

        },

        "out_of_scope": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "source_material": {

      "type": "array",

      "minItems": 1,

      "items": {

        "type": "object",

        "additionalProperties": false,

        "required": [

          "id",

          "title",

          "language",

          "local_path",

          "status"

        ],

        "properties": {

          "id": {

            "$ref": "#/$defs/string_id"

          },

          "title": {

            "type": "string",

            "minLength": 1

          },

          "language": {

            "type": "string",

            "enum": [

              "en",

              "zh"

            ]

          },

          "local_path": {

            "type": "string",

            "minLength": 1

          },

          "status": {

            "type": "string",

            "enum": [

              "ocr_required",

              "ocr_extracted",

              "text_layer_available",

              "verified",

              "missing"

            ]

          },

          "formal_citation_status": {

            "type": "string",

            "enum": [

              "local_source_only",

              "doi_verified",

              "not_for_formal_citation"

            ]

          }

        }

      }

    },

    "control_objectives": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "controlled_variables": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "feedback_signals": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "controllers": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "actuators": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "disturbance_classes": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "stability_metrics": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/control_item"

      }

    },

    "adaptation_rules": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/adaptation_rule"

      }

    },

    "memory_policy_ref": {

      "type": "string",

      "minLength": 1

    },

    "external_adoption_policy_ref": {

      "type": "string",

      "minLength": 1

    }

  },

  "$defs": {

    "string_id": {

      "type": "string",

      "pattern": "^[A-Za-z0-9_.-]+$"

    },

    "string_list": {

      "type": "array",

      "items": {

        "type": "string",

        "minLength": 1

      },

      "uniqueItems": true

    },

    "control_item": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "name",

        "description",

        "owner"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/string_id"

        },

        "name": {

          "type": "string",

          "minLength": 1

        },

        "description": {

          "type": "string",

          "minLength": 1

        },

        "owner": {

          "type": "string",

          "minLength": 1

        },

        "signals": {

          "$ref": "#/$defs/string_list"

        },

        "gates": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "adaptation_rule": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "trigger",

        "controller",

        "allowed_targets",

        "required_gates",

        "rollback"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/string_id"

        },

        "trigger": {

          "type": "string",

          "minLength": 1

        },

        "controller": {

          "type": "string",

          "minLength": 1

        },

        "allowed_targets": {

          "$ref": "#/$defs/string_list"

        },

        "required_gates": {

          "$ref": "#/$defs/string_list"

        },

        "rollback": {

          "type": "string",

          "minLength": 1

        }

      }

    }

  }

}
