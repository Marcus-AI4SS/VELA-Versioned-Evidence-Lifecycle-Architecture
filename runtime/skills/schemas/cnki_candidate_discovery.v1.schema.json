{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/cnki_candidate_discovery.v1.schema.json",

  "title": "CNKI Candidate Discovery Report",

  "type": "object",

  "additionalProperties": true,

  "required": [

    "schema_version",

    "generated_at",

    "workflow_id",

    "ok",

    "mode",

    "source_files_written",

    "query",

    "search_type",

    "sort",

    "accepted_count",

    "rejected_count",

    "candidates",

    "errors"

  ],

  "properties": {

    "schema_version": {

      "const": "cnki_candidate_discovery.v1"

    },

    "generated_at": {

      "type": "string",

      "minLength": 1

    },

    "workflow_id": {

      "type": "string",

      "minLength": 1

    },

    "ok": {

      "type": "boolean"

    },

    "mode": {

      "const": "direct_cdp_discovery"

    },

    "source_files_written": {

      "const": false

    },

    "query": {

      "type": "string",

      "minLength": 1

    },

    "search_type": {

      "type": "string",

      "minLength": 1

    },

    "requested_author": {

      "type": [

        "string",

        "null"

      ]

    },

    "requested_affiliation": {

      "type": [

        "string",

        "null"

      ]

    },

    "sort": {

      "enum": [

        "relevance",

        "date",

        "cited",

        "download",

        "composite"

      ]

    },

    "accepted_count": {

      "type": "integer",

      "minimum": 0

    },

    "rejected_count": {

      "type": "integer",

      "minimum": 0

    },

    "candidates": {

      "type": "array",

      "items": {

        "type": "object",

        "additionalProperties": true,

        "required": [

          "title",

          "detail_url",

          "evidence_sources"

        ],

        "properties": {

          "title": {

            "type": [

              "string",

              "null"

            ]

          },

          "detail_url": {

            "type": [

              "string",

              "null"

            ]

          },

          "evidence_sources": {

            "type": "array",

            "items": {

              "type": "string"

            }

          }

        }

      }

    },

    "errors": {

      "type": "array",

      "items": {

        "type": "string"

      }

    }

  }

}
