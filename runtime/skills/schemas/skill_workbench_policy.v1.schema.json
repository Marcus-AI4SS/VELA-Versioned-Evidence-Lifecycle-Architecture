{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://marcus-ai4ss.github.io/VELA/schemas/skill_workbench_policy.v1.schema.json",

  "title": "Skill Workbench Policy",

  "type": "object",

  "additionalProperties": false,

  "required": [

    "$schema",

    "schema_version",

    "updated_at",

    "policy",

    "source_review_refs",

    "adoption_options",

    "selected_strategy",

    "local_boundaries",

    "package_contracts",

    "borrowed_patterns",

    "required_workflow",

    "safety_rules"

  ],

  "properties": {

    "$schema": {

      "type": "string",

      "minLength": 1

    },

    "schema_version": {

      "const": "skill_workbench_policy.v1"

    },

    "updated_at": {

      "type": "string",

      "minLength": 1

    },

    "policy": {

      "type": "string",

      "minLength": 1

    },

    "source_review_refs": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/source_ref"

      }

    },

    "adoption_options": {

      "type": "array",

      "minItems": 3,

      "items": {

        "$ref": "#/$defs/adoption_option"

      }

    },

    "selected_strategy": {

      "type": "string",

      "minLength": 1

    },

    "local_boundaries": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "source_of_truth",

        "runtime_mirrors",

        "protected_runtime_policy",

        "external_repo_policy"

      ],

      "properties": {

        "source_of_truth": {

          "type": "string",

          "minLength": 1

        },

        "runtime_mirrors": {

          "$ref": "#/$defs/string_list"

        },

        "protected_runtime_policy": {

          "type": "string",

          "minLength": 1

        },

        "external_repo_policy": {

          "type": "string",

          "minLength": 1

        }

      }

    },

    "package_contracts": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/package_contract"

      }

    },

    "borrowed_patterns": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/borrowed_pattern"

      }

    },

    "required_workflow": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/workflow_step"

      }

    },

    "safety_rules": {

      "type": "array",

      "minItems": 1,

      "items": {

        "$ref": "#/$defs/safety_rule"

      }

    }

  },

  "$defs": {

    "non_empty_string": {

      "type": "string",

      "minLength": 1

    },

    "string_list": {

      "type": "array",

      "items": {

        "$ref": "#/$defs/non_empty_string"

      },

      "uniqueItems": true

    },

    "source_ref": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "upstream",

        "repo_url",

        "adopted_as"

      ],

      "properties": {

        "upstream": {

          "$ref": "#/$defs/non_empty_string"

        },

        "repo_url": {

          "type": "string",

          "format": "uri"

        },

        "adopted_as": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "adoption_option": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "label",

        "decision",

        "description",

        "strengths",

        "risks"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "label": {

          "$ref": "#/$defs/non_empty_string"

        },

        "decision": {

          "type": "string",

          "enum": [

            "selected",

            "partial",

            "watch",

            "reject_as_default"

          ]

        },

        "description": {

          "$ref": "#/$defs/non_empty_string"

        },

        "strengths": {

          "$ref": "#/$defs/string_list"

        },

        "risks": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "package_contract": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "scope",

        "canonical_location",

        "runtime_location",

        "required_files",

        "validation"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "scope": {

          "$ref": "#/$defs/non_empty_string"

        },

        "canonical_location": {

          "$ref": "#/$defs/non_empty_string"

        },

        "runtime_location": {

          "$ref": "#/$defs/non_empty_string"

        },

        "required_files": {

          "$ref": "#/$defs/string_list"

        },

        "validation": {

          "$ref": "#/$defs/string_list"

        }

      }

    },

    "borrowed_pattern": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "source",

        "local_adaptation",

        "not_adopted"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "source": {

          "$ref": "#/$defs/non_empty_string"

        },

        "local_adaptation": {

          "$ref": "#/$defs/non_empty_string"

        },

        "not_adopted": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    },

    "workflow_step": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "order",

        "id",

        "action",

        "output"

      ],

      "properties": {

        "order": {

          "type": "integer",

          "minimum": 1

        },

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "action": {

          "$ref": "#/$defs/non_empty_string"

        },

        "output": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    },

    "safety_rule": {

      "type": "object",

      "additionalProperties": false,

      "required": [

        "id",

        "rule",

        "failure_action"

      ],

      "properties": {

        "id": {

          "$ref": "#/$defs/non_empty_string"

        },

        "rule": {

          "$ref": "#/$defs/non_empty_string"

        },

        "failure_action": {

          "$ref": "#/$defs/non_empty_string"

        }

      }

    }

  }

}
